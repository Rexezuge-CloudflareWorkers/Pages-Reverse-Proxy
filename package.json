{
  "name": "pages-reverse-proxy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "wrangler types --config wrangler.template.jsonc",
    "typegen": "wrangler types --config wrangler.template.jsonc",
    "typecheck": "tsc --noEmit",
    "configure:pages": "node scripts/deploy/configure-pages-bindings.ts",
    "lint": "eslint --ext .ts --fix --quiet .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.1",
    "wrangler": "4.143.0"
  },
  "packageManager": "pnpm@11.2.2"
}